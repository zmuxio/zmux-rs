{
  "protocol": {
    "name": "zmux",
    "alpn_default": "qmux-02",
    "alpn_also_accepted": [
      "qmux-01"
    ],
    "alpn_alias_rule": [
      "qmux-02 -> qmux-01",
      "qmux-02.<application> -> qmux-01.<application>",
      "<name>-02 -> <name>-01",
      "otherwise no alias"
    ],
    "alpn_alias_examples": [
      {
        "configured": "qmux-02",
        "alias": "qmux-01",
        "not_accepted": [
          "qmux-00",
          "qmux-01.x",
          "qmux"
        ]
      },
      {
        "configured": "qmux-02.myapp-v4",
        "alias": "qmux-01.myapp-v4",
        "not_accepted": [
          "qmux-01.myapp-v3",
          "qmux-00.myapp-v4",
          "myapp-v4",
          "QMUX-01.myapp-v4"
        ]
      },
      {
        "configured": "h3qx-02",
        "alias": "h3qx-01",
        "not_accepted": [
          "h3qx-00",
          "h3qx"
        ]
      },
      {
        "configured": "myapp-02",
        "alias": "myapp-01",
        "not_accepted": [
          "myapp-1"
        ]
      },
      {
        "configured": "myapp",
        "alias": null,
        "not_accepted": [
          "myapp-01"
        ]
      }
    ],
    "qmux_draft": "draft-ietf-quic-qmux-02",
    "reliable_stream_reset_draft": "draft-ietf-quic-reliable-stream-reset-11"
  },
