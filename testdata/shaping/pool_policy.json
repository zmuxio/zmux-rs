    {"name": "probe_interval_over_1e9", "policy": {"probe_interval": {"const": 2000000000.0}}, "steps": [{"want": {"probe_interval": 2000000000.0}}], "note": "executor emits it; the pool rejects the decision (keep, report)"},
    {"name": "count_draw_rounds_half_up", "policy": {"count": {"const": 2.5}}, "steps": [{"want": {"count": 3}}], "note": "half away from zero"}
