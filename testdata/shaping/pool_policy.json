{
  "version": 3,
  "parse": [
    {"name": "empty", "policy": {}, "ok": true},
    {"name": "all_fields", "policy": {
      "count": {"dist": {"kind": "poisson", "params": [2.5]}, "scope": "shared", "min": 1, "max": 5},
      "dial_after": [
        {"dist": {"kind": "empirical", "points": [0.5, 1.5, 2.5], "weights": [1, 2, 1]}, "min": 0.2, "max": 3},
        {"dist": {"kind": "weibull", "params": [8, 1.5]}, "min": 1, "max": 15}
      ],
      "retire": [
        {"metric": "age", "above": {"dist": {"kind": "gamma", "params": [5, 400]}, "scope": "pipe", "min": 500, "max": 5000}},
        {"metric": "bytes", "above": {"dist": {"kind": "lognormal", "params": [19.5, 0.4]}, "scope": "pipe", "min": 50000000, "max": 900000000}},
        {"metric": "idle", "above": {"range": [150, 250], "scope": "pipe", "min": 120, "max": 240}}
      ]}, "ok": true},
    {"name": "every_metric", "policy": {"retire": [
      {"metric": "age", "above": {"const": 1}}, {"metric": "idle", "above": {"const": 1}},
      {"metric": "pipes", "above": {"const": 1}}, {"metric": "bytes_sent", "above": {"const": 1}},
      {"metric": "bytes_received", "above": {"const": 1}}, {"metric": "bytes", "above": {"const": 1}}]}, "ok": true},
    {"name": "scope_names", "policy": {"count": {"const": 1, "scope": "shared"}, "dial_after": [
      {"const": 1, "scope": "each"}, {"const": 1}]}, "ok": true},
    {"name": "scope_session", "policy": {"count": {"const": 1, "scope": "session"}}, "ok": false},
    {"name": "scope_instance", "policy": {"dial_after": [{"const": 1, "scope": "instance"}]}, "ok": false},
    {"name": "scope_record", "policy": {"retire": [{"metric": "age", "above": {"const": 1, "scope": "record"}}]}, "ok": false},
    {"name": "empty_lists", "policy": {"dial_after": [], "retire": []}, "ok": true},
    {"name": "mixture", "policy": {"count": {"dist": {"kind": "mixture", "of": [{"const": 1}, {"range": [2, 3]}], "weights": [1, 1]}}}, "ok": true},
    {"name": "unknown_field", "policy": {"count": {"const": 1}, "redial_after": {"const": 1}}, "ok": false},
    {"name": "unknown_metric", "policy": {"retire": [{"metric": "lifetime", "above": {"const": 1}}]}, "ok": false},
    {"name": "rule_unknown_field", "policy": {"retire": [{"metric": "age", "above": {"const": 1}, "below": {"const": 0}}]}, "ok": false},
    {"name": "rule_without_above", "policy": {"retire": [{"metric": "age"}]}, "ok": false},
    {"name": "rule_without_metric", "policy": {"retire": [{"above": {"const": 1}}]}, "ok": false},
    {"name": "value_two_kinds", "policy": {"count": {"const": 1, "range": [1, 2]}}, "ok": false},
    {"name": "value_no_kind", "policy": {"count": {"min": 1}}, "ok": false},
    {"name": "range_reversed", "policy": {"dial_after": [{"range": [2, 1]}]}, "ok": false},
    {"name": "unknown_scope", "policy": {"count": {"const": 1, "scope": "member"}}, "ok": false},
    {"name": "dist_bad_params", "policy": {"retire": [{"metric": "age", "above": {"dist": {"kind": "gamma", "params": [0, 1]}}}]}, "ok": false},
    {"name": "dist_unknown_kind", "policy": {"count": {"dist": {"kind": "zipf", "params": [1]}}}, "ok": false},
    {"name": "min_above_max", "policy": {"count": {"const": 1, "min": 3, "max": 2}}, "ok": false},
    {"name": "pipe_scope_in_count", "policy": {"count": {"const": 1, "scope": "pipe"}}, "ok": false},
    {"name": "pipe_scope_in_dial_after", "policy": {"dial_after": [{"const": 1}, {"const": 1, "scope": "pipe"}]}, "ok": false},
    {"name": "pipe_scope_in_mixture_count", "policy": {"count": {"dist": {"kind": "mixture", "of": [{"const": 1, "scope": "pipe"}], "weights": [1]}}}, "ok": false},
    {"name": "dial_after_not_list", "policy": {"dial_after": {"const": 1}}, "ok": false},
    {"name": "count_not_object", "policy": {"count": 2}, "ok": false},
    {"name": "count_below_one", "policy": {"count": {"const": 0.2}}, "ok": false},
    {"name": "count_negative", "policy": {"count": {"const": -4}}, "ok": false},
    {"name": "count_normal_without_min", "policy": {"count": {"dist": {"kind": "normal", "params": [3, 1]}}}, "ok": false},
    {"name": "count_normal_min_below_one", "policy": {"count": {"dist": {"kind": "normal", "params": [3, 1]}, "min": 0}}, "ok": false},
    {"name": "count_normal_min_one", "policy": {"count": {"dist": {"kind": "normal", "params": [3, 1]}, "min": 1}}, "ok": true},
    {"name": "count_poisson_without_min", "policy": {"count": {"dist": {"kind": "poisson", "params": [3]}}}, "ok": false},
    {"name": "not_object", "policy": [], "ok": false},
    {"name": "jitter_fields", "policy": {
      "dial_after": [{"const": 1}, {"range": [5, 10]}], "dial_jitter": 0.5,
      "retire": [{"metric": "age", "above": {"const": 600}, "jitter": 0.3},
                 {"metric": "bytes", "above": {"const": 1e9, "scope": "shared"}, "jitter": 0},
                 {"metric": "pipes", "above": {"const": 4}, "jitter": 0.1}],
      "probe_interval": {"range": [10, 20], "scope": "shared"}, "probe_jitter": 0.25}, "ok": true},
    {"name": "probe_interval_alone", "policy": {"probe_interval": {"const": 15}}, "ok": true},
    {"name": "retire_jitter_negative", "policy": {"retire": [{"metric": "age", "above": {"const": 1}, "jitter": -0.1}]}, "ok": false},
    {"name": "retire_jitter_one", "policy": {"retire": [{"metric": "age", "above": {"const": 1}, "jitter": 1}]}, "ok": false},
    {"name": "retire_jitter_string", "policy": {"retire": [{"metric": "age", "above": {"const": 1}, "jitter": "0.2"}]}, "ok": false},
    {"name": "retire_jitter_value", "policy": {"retire": [{"metric": "age", "above": {"const": 1}, "jitter": {"const": 0.2}}]}, "ok": false},
    {"name": "dial_jitter_one", "policy": {"dial_after": [{"const": 1}], "dial_jitter": 1}, "ok": false},
    {"name": "dial_jitter_without_dial_after", "policy": {"dial_jitter": 0.2}, "ok": false},
    {"name": "probe_jitter_without_interval", "policy": {"probe_jitter": 0.2}, "ok": false},
    {"name": "probe_jitter_one", "policy": {"probe_interval": {"const": 15}, "probe_jitter": 1}, "ok": false},
    {"name": "probe_interval_pipe_scope", "policy": {"probe_interval": {"const": 15, "scope": "pipe"}}, "ok": false},
    {"name": "probe_interval_mixture_pipe_scope", "policy": {"probe_interval": {"dist": {"kind": "mixture", "of": [{"const": 15, "scope": "pipe"}], "weights": [1]}}}, "ok": false},
    {"name": "probe_interval_number", "policy": {"probe_interval": 15}, "ok": false},
    {"name": "count_geometric_without_min", "policy": {"count": {"dist": {"kind": "geometric", "params": [0.5]}}}, "ok": true, "note": "lower bound 1"},
    {"name": "count_pareto", "policy": {"count": {"dist": {"kind": "pareto", "params": [0.5, 2]}}}, "ok": false, "error": "below 1", "note": "lower bound = scale 0.5"},
    {"name": "count_pareto_scale_one", "policy": {"count": {"dist": {"kind": "pareto", "params": [1, 2]}}}, "ok": true, "note": "lower bound = scale 1"},
    {"name": "count_const_max_below_one", "policy": {"count": {"const": 3, "max": 0.5}}, "ok": false, "error": "below 1", "note": "max counts in the lower bound"},
    {"name": "count_mixture_zero_weight_zero", "policy": {"count": {"dist": {"kind": "mixture", "of": [{"const": 0}, {"const": 2}], "weights": [0, 1]}}}, "ok": false, "error": "below 1", "note": "weight-0 component counts"},
    {"name": "count_overflow", "policy": {"count": {"const": 1e+16}}, "ok": false, "error": "max", "note": "declared count > 2^53"},
    {"name": "count_overflow_raw", "raw": "{\"count\":{\"const\":1e400}}", "ok": false, "error": "overflow", "note": "parse error"},
    {"name": "value_unknown_field", "policy": {"count": {"const": 2, "mean": 3}}, "ok": false, "error": "unknown field", "note": "unknown member of a Value"},
    {"name": "dist_unknown_field", "policy": {"count": {"dist": {"kind": "poisson", "params": [2], "weights": [1]}, "min": 1}}, "ok": false, "error": "unknown field", "note": "weights is not a poisson member"},
    {"name": "uppercase_field", "policy": {"Count": {"const": 2}}, "ok": false, "error": "unknown field", "note": "case-sensitive"},
    {"name": "uppercase_metric", "policy": {"retire": [{"metric": "Age", "above": {"const": 1}}]}, "ok": false, "error": "metric", "note": "case-sensitive enum"},
    {"name": "duplicate_key", "raw": "{\"count\":{\"const\":1},\"count\":{\"const\":2}}", "ok": false, "error": "duplicate", "note": "duplicate member"},
    {"name": "jitter_null", "policy": {"retire": [{"metric": "age", "above": {"const": 10}, "jitter": null}], "dial_jitter": null, "probe_jitter": null}, "ok": true, "note": "null = absent = 0; no dial_after/probe_interval needed"},
    {"name": "fields_null", "policy": {"count": null, "dial_after": null, "retire": null, "probe_interval": null}, "ok": true, "note": "null = absent"},
    {"name": "dial_after_negative", "policy": {"dial_after": [{"const": -3}]}, "ok": false, "error": "negative", "note": "replaces dial_after_negative_passes_to_rejection"},
    {"name": "dial_after_normal_without_min", "policy": {"dial_after": [{"dist": {"kind": "normal", "params": [5, 2]}}]}, "ok": false, "error": "negative", "note": "lower bound -inf"},
    {"name": "retire_above_negative", "policy": {"retire": [{"metric": "age", "above": {"const": -1}}]}, "ok": false, "error": "negative", "note": "declared negative"},
    {"name": "retire_above_range_negative", "policy": {"retire": [{"metric": "bytes", "above": {"range": [-1, 10], "min": 0}}]}, "ok": false, "error": "negative", "note": "declared negative even with min"},
    {"name": "probe_interval_negative", "policy": {"probe_interval": {"const": -5}}, "ok": false, "error": "negative", "note": "replaces probe_interval_negative_passes_to_rejection"},
    {"name": "probe_interval_over_1e9_loads", "policy": {"probe_interval": {"const": 2000000000.0}}, "ok": true, "note": "outside {0} U [1, 1e9] is a decision-time rejection (decide vector probe_interval_over_1e9)"},
    {"name": "dial_after_over_1e9", "policy": {"dial_after": [{"const": 2000000000.0}]}, "ok": false, "error": "max", "note": "declared seconds > 1e9"},
    {"name": "jitter_decimal_ok", "raw": "{\"retire\":[{\"metric\":\"age\",\"above\":{\"const\":1},\"jitter\":0}]}", "ok": true, "note": "jitter is a number; integer 0 is fine"},
    {"name": "scope_empty_string", "policy": {"count": {"const": 1, "scope": ""}}, "ok": false, "error": "scope", "note": "no alias; changes existing scope_names (drop its \"\" item)"}
  ],
  "decide": [
    {"name": "empty_keeps_pool", "policy": {}, "steps": [
