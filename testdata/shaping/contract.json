{
  "version": 1,
  "records": [
    {"name": "pad_to", "plan": {"pad_to": 300}, "send": 10, "expect": {"min_len": 300, "padding": true}},
    {"name": "pad_multiple_and_pad", "plan": {"pad_multiple": 100, "pad": 3}, "send": 1000, "expect": {"mod": 100, "rem": 3}},
    {"name": "max_len", "plan": {"max_len": 100}, "send": 5000, "expect": {"max_len": 100, "min_records": 50}},
    {"name": "clamp_to_limit", "plan": {"pad_to": 1048576}, "send": 10, "expect": {"max_len": 65535, "clamped": true}},
    {"name": "padding_bytes_bound", "limits": {"max_padding_bytes": 500}, "plan": {"pad": 300}, "send": 10, "repeat": 2,
      "expect": {"max_padding_bytes": 500, "clamped": true}},
    {"name": "server_pad_each_record", "side": "server", "plan": {"max_len": 300, "pad": 16}, "send": 20000,
      "expect": {"min_records": 60, "min_pad": 16}}
  ],
  "definitions": [
    {"name": "bad_version", "json": {"version": 2, "machines": [{"states": [{}]}]}, "error": "version"},
    {"name": "no_machines", "json": {"version": 1}, "error": "no machines"},
    {"name": "start_range", "json": {"version": 1, "machines": [{"start": 1, "states": [{}]}]}, "error": "start"},
    {"name": "unknown_trigger", "json": {"version": 1, "machines": [{"states": [{"next": [{"on": "x", "to": 0}]}]}]}, "error": "trigger"},
    {"name": "target_range", "json": {"version": 1, "machines": [{"states": [{"next": [{"on": "enter", "to": 3}]}]}]}, "error": "target"},
    {"name": "unknown_op", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "x"}]}]}]}, "error": "op"},
    {"name": "missing_value", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "inject"}]}]}]}, "error": "missing"},
    {"name": "param_count", "json": {"version": 1, "machines": [{"states": [{"record": {"pad": {"dist": {"kind": "normal", "params": [1]}}}}]}]}, "error": "params"},
    {"name": "bad_range", "json": {"version": 1, "machines": [{"states": [{"record": {"pad": {"range": [2, 1]}}}]}]}, "error": "range"},
    {"name": "normal_pad_without_min", "json": {"version": 1, "machines": [{"states": [{"record": {"pad": {"dist": {"kind": "normal", "params": [100, 30]}}}}]}]}, "error": "negative"},
    {"name": "normal_rate_without_min", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "rate", "rate": {"dist": {"kind": "normal", "params": [1000, 100]}}}]}]}]}, "error": "negative"},
    {"name": "normal_burst_negative_min", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "rate", "rate": {"const": 1000}, "burst": {"dist": {"kind": "normal", "params": [10, 5]}, "min": -1}}]}]}]}, "error": "negative"},
    {"name": "mixture_normal_without_min", "json": {"version": 1, "machines": [{"states": [{"record": {"delay": {"dist": {"kind": "mixture", "of": [{"const": 1}, {"dist": {"kind": "normal", "params": [1, 1]}}], "weights": [1, 1]}}}}]}]}, "error": "negative"},
    {"name": "counter_negative", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "set", "slot": 0, "value": {"const": -1}}]}]}]}, "error": "negative"},
    {"name": "empty_value", "json": {"version": 1, "machines": [{"states": [{"record": {"pad": {}}}]}]}, "error": "exactly one"},
    {"name": "unreachable", "json": {"version": 1, "machines": [{"states": [{}, {}]}]}, "error": "unreachable"},
    {"name": "start_restarts", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "restart"}]}]}]}, "error": "restart"},
    {"name": "zero_delay_cycle", "json": {"version": 1, "machines": [{"states": [
      {"enter": [{"op": "inject", "after": {"const": 0}, "len": {"const": 1}}], "next": [{"on": "injected", "to": 0}]}]}]},
      "error": "zero delay"},
    {"name": "counter_chain", "json": {"version": 1, "machines": [{"states": [
      {"record": {"pad": {"const": 1}}, "enter": [{"op": "set", "value": {"const": 2}}], "next": [{"on": "record_out", "to": 1}]},
      {"record": {"pad": {"const": 1}}, "enter": [{"op": "sub", "value": {"const": 1}}],
        "next": [{"on": "zero0", "to": 2}, {"on": "record_out", "to": 1}]},
      {}]}]},
      "plans": [{"pad": 1}, {"pad": 1}, {}, {}, {}]},
    {"name": "guard_and_prob", "json": {"version": 1, "machines": [{"states": [
      {"record": {"pad": {"const": 1}}, "next": [
        {"on": "record_out", "to": 1, "if": {"what": "seq", "cmp": "ge", "value": {"const": 2}}},
        {"on": "record_out", "to": 1, "prob": {"const": 0}}]},
      {}]}]},
      "plans": [{"pad": 1}, {"pad": 1}, {"pad": 1}, {}, {}]},
    {"name": "record_fields", "json": {"version": 1, "machines": [{"states": [{"record": {"max_len": {"const": 7},
      "pad_to": {"const": 5}, "pad_multiple": {"const": 4}, "pad": {"const": 3}, "delay": {"const": 0.002}, "flush": true}}]}]},
      "plans": [{"max_len": 7, "pad_to": 5, "pad_multiple": 4, "pad": 3, "delay_ns": 2000000, "flush": true}]},
    {"name": "unknown_scope", "json": {"version": 1, "machines": [{"states": [{"record": {"pad": {"const": 1, "scope": "x"}}}]}]}, "error": "scope"},
    {"name": "cancel_and_scopes", "json": {"version": 1, "machines": [{"states": [{
      "enter": [{"op": "inject", "cancel": true}, {"op": "timer", "slot": 1, "cancel": true}],
      "record": {"pad": {"const": 1, "scope": "shared"}, "pad_to": {"const": 2, "scope": "each"}, "max_len": {"const": 9, "scope": "pipe"}}}]}]},
      "plans": [{"max_len": 9, "pad_to": 2, "pad": 1}, {"max_len": 9, "pad_to": 2, "pad": 1}]},
    {"name": "sequence_steps", "sequence": "100, 200/delay=0.001, 300",
      "plans": [{"max_len": 100, "pad_to": 100}, {"max_len": 200, "pad_to": 200, "delay_ns": 1000000},
        {"max_len": 300, "pad_to": 300, "stop": true}, {}]},
    {"name": "sequence_until", "sequence": "50/until=seq>=1, 50/until=seq>=1, 50, 50",
      "plans": [{"max_len": 50, "pad_to": 50}, {"max_len": 50, "pad_to": 50, "stop": true}, {}]},
    {"name": "sequence_errors_modifier", "sequence": "10/x=1", "error": "unknown modifier"},
    {"name": "sequence_errors_number", "sequence": "10,abc", "error": "step 1"},
    {"name": "sequence_errors_guard", "sequence": "10/until=foo<1", "error": "unknown quantity"},
    {"name": "sequence_errors_dist", "sequence": "normal(1)", "error": "params"},
    {"name": "max_len_negative", "json": {"version": 1, "machines": [{"states": [{"record": {"max_len": {"const": -1}}}]}]}, "error": "negative", "note": "record.max_len const < 0"},
    {"name": "delay_range_negative", "json": {"version": 1, "machines": [{"states": [{"record": {"delay": {"range": [-0.01, 0.02]}}}]}]}, "error": "negative", "note": "range end < 0 even though draws could be >= 0 after a min"},
    {"name": "delay_range_negative_with_min", "json": {"version": 1, "machines": [{"states": [{"record": {"delay": {"range": [-0.01, 0.02], "min": 0}}}]}]}, "error": "negative", "note": "a declared negative number is rejected even when min would lift every draw"},
    {"name": "pause_after_negative", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "pause", "after": {"const": -1}}]}]}]}, "error": "negative", "note": "pause.after < 0"},
    {"name": "timer_after_negative", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "timer", "after": {"const": -0.5}}]}]}]}, "error": "negative", "note": "timer.after < 0"},
    {"name": "inject_len_negative", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "inject", "after": {"const": 1}, "len": {"const": -10}}]}]}]}, "error": "negative", "note": "inject.len < 0"},
    {"name": "inject_after_negative", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "inject", "after": {"const": -1}, "len": {"const": 10}}]}]}]}, "error": "negative", "note": "inject.after < 0"},
    {"name": "rate_negative", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "rate", "rate": {"const": -1000}}]}]}]}, "error": "negative", "note": "rate < 0"},
    {"name": "burst_negative", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "rate", "rate": {"const": 1000}, "burst": {"const": -1}}]}]}]}, "error": "negative", "note": "burst < 0"},
    {"name": "counter_add_negative", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "add", "value": {"const": -1}}]}]}]}, "error": "negative", "note": "add value < 0"},
    {"name": "counter_sub_negative", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "sub", "value": {"const": -1}}]}]}]}, "error": "negative", "note": "sub value < 0"},
    {"name": "pad_multiple_negative_max", "json": {"version": 1, "machines": [{"states": [{"record": {"pad_multiple": {"range": [1, 4], "max": -1}}}]}]}, "error": "negative", "note": "declared max < 0"},
    {"name": "pad_points_negative", "json": {"version": 1, "machines": [{"states": [{"record": {"pad": {"dist": {"kind": "bag", "points": [1, -2, 3]}}}}]}]}, "error": "negative", "note": "a point < 0"},
    {"name": "inject_cancel_with_negative_after", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "inject", "cancel": true, "after": {"const": -1}}]}]}]}, "error": "negative", "note": "a field present is validated whatever cancel is"},
    {"name": "timer_cancel_with_negative_after", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "timer", "slot": 1, "cancel": true, "after": {"const": -1}}]}]}]}, "error": "negative", "note": "same for timer"},
    {"name": "pause_with_len", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "pause", "after": {"const": 1}, "len": {"const": 10}}]}]}]}, "error": "unknown field", "note": "len is not a pause field"},
    {"name": "stop_with_value", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "stop", "value": {"const": 1}}]}]}]}, "error": "unknown field", "note": "stop takes no operand"},
    {"name": "rate_with_slot", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "rate", "rate": {"const": 1000}, "slot": 1}]}]}]}, "error": "unknown field", "note": "slot is not a rate field"},
    {"name": "set_with_cancel", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "set", "value": {"const": 1}, "cancel": true}]}]}]}, "error": "unknown field", "note": "cancel only for inject and timer"},
    {"name": "weight_with_slot", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "weight", "value": {"const": 2}, "slot": 0}]}]}]}, "error": "unknown field", "note": "slot is not a weight field, even when 0"},
    {"name": "op_fields_null", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "pause", "after": {"const": 1}, "len": null, "rate": null}]}]}]}, "ok": true, "note": "null is absent, so a null unused field is fine"},
    {"name": "weight_negative", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "weight", "value": {"const": -1}}]}]}]}, "ok": true, "note": "weight value is not a non-negative field"},
    {"name": "prob_above_one", "json": {"version": 1, "machines": [{"states": [{"next": [{"on": "record_out", "to": 0, "prob": {"const": 1.5}}]}]}]}, "error": "prob", "note": "const > 1"},
    {"name": "prob_negative", "json": {"version": 1, "machines": [{"states": [{"next": [{"on": "record_out", "to": 0, "prob": {"const": -0.1}}]}]}]}, "error": "prob", "note": "const < 0"},
    {"name": "prob_normal_without_bounds", "json": {"version": 1, "machines": [{"states": [{"next": [{"on": "record_out", "to": 0, "prob": {"dist": {"kind": "normal", "params": [0.5, 0.1]}}}]}]}]}, "error": "prob", "note": "normal has no lower or upper bound"},
    {"name": "prob_normal_min_only", "json": {"version": 1, "machines": [{"states": [{"next": [{"on": "record_out", "to": 0, "prob": {"dist": {"kind": "normal", "params": [0.5, 0.1]}, "min": 0}}]}]}]}, "error": "prob", "note": "upper bound +inf > 1"},
    {"name": "prob_exponential", "json": {"version": 1, "machines": [{"states": [{"next": [{"on": "record_out", "to": 0, "prob": {"dist": {"kind": "exponential", "params": [10]}}}]}]}]}, "error": "prob", "note": "upper bound +inf"},
    {"name": "prob_normal_bounded", "json": {"version": 1, "machines": [{"states": [{"next": [{"on": "record_out", "to": 0, "prob": {"dist": {"kind": "normal", "params": [0.5, 0.1]}, "min": 0, "max": 1}}]}]}]}, "ok": true, "note": "both bounds in [0, 1]"},
    {"name": "prob_beta", "json": {"version": 1, "machines": [{"states": [{"next": [{"on": "record_out", "to": 0, "prob": {"dist": {"kind": "beta", "params": [2, 5]}}}]}]}]}, "ok": true, "note": "beta lies in [0, 1]"},
    {"name": "start_decimal", "raw": "{\"version\":1,\"machines\":[{\"start\":0.0,\"states\":[{}]}]}", "error": "integer", "note": "start must be a JSON integer"},
    {"name": "version_decimal", "raw": "{\"version\":1.0,\"machines\":[{\"states\":[{}]}]}", "error": "integer", "note": "version must be a JSON integer"},
    {"name": "slot_decimal", "raw": "{\"version\":1,\"machines\":[{\"states\":[{\"enter\":[{\"op\":\"timer\",\"slot\":1.0,\"after\":{\"const\":1}}]}]}]}", "error": "integer", "note": "slot must be a JSON integer"},
    {"name": "to_decimal", "raw": "{\"version\":1,\"machines\":[{\"states\":[{\"next\":[{\"on\":\"record_out\",\"to\":0.0}]}]}]}", "error": "integer", "note": "to must be a JSON integer"},
    {"name": "start_exponent", "raw": "{\"version\":1,\"machines\":[{\"start\":0e0,\"states\":[{}]}]}", "error": "integer", "note": "an exponent is not an integer form"},
    {"name": "const_overflow", "raw": "{\"version\":1,\"machines\":[{\"states\":[{\"record\":{\"pad\":{\"const\":1e400}}}]}]}", "error": "overflow", "note": "outside binary64: parse error"},
    {"name": "const_nan", "raw": "{\"version\":1,\"machines\":[{\"states\":[{\"record\":{\"pad\":{\"const\":NaN}}}]}]}", "error": "parse", "note": "NaN is not JSON"},
    {"name": "null_start", "raw": "{\"version\":1,\"machines\":[{\"start\":null,\"states\":[{}]}]}", "note": "null = absent: start 0; loads", "ok": true},
    {"name": "null_record_field", "raw": "{\"version\":1,\"machines\":[{\"states\":[{\"record\":{\"pad\":null,\"flush\":null}}]}]}", "note": "null = absent; loads, plans empty", "ok": true},
    {"name": "null_version", "raw": "{\"version\":null,\"machines\":[{\"states\":[{}]}]}", "error": "version", "note": "null = absent, and version is required"},
    {"name": "unknown_field_in_state", "raw": "{\"version\":1,\"machines\":[{\"states\":[{\"recrod\":{}}]}]}", "error": "unknown field", "note": "misspelt member of a state"},
    {"name": "unknown_field_in_value", "raw": "{\"version\":1,\"machines\":[{\"states\":[{\"record\":{\"pad\":{\"const\":1,\"mean\":2}}}]}]}", "error": "unknown field", "note": "unknown member of a Value"},
    {"name": "unknown_field_in_dist", "raw": "{\"version\":1,\"machines\":[{\"states\":[{\"record\":{\"pad\":{\"dist\":{\"kind\":\"poisson\",\"params\":[3],\"points\":[1]}}}}]}]}", "error": "unknown field", "note": "points is not a poisson member"},
    {"name": "unknown_field_top", "raw": "{\"version\":1,\"machines\":[{\"states\":[{}]}],\"name\":\"x\"}", "error": "unknown field", "note": "top level"},
    {"name": "uppercase_key", "raw": "{\"version\":1,\"machines\":[{\"states\":[{\"Record\":{\"pad\":{\"const\":1}}}]}]}", "error": "unknown field", "note": "member names are case-sensitive"},
    {"name": "uppercase_enum", "raw": "{\"version\":1,\"machines\":[{\"states\":[{\"enter\":[{\"op\":\"Stop\"}]}]}]}", "error": "op", "note": "enum values are case-sensitive"},
    {"name": "duplicate_key", "raw": "{\"version\":1,\"machines\":[{\"states\":[{\"record\":{\"pad\":{\"const\":1},\"pad\":{\"const\":2}}}]}]}", "error": "duplicate", "note": "duplicate member"},
    {"name": "scope_empty_string", "raw": "{\"version\":1,\"machines\":[{\"states\":[{\"record\":{\"pad\":{\"const\":1,\"scope\":\"\"}}}]}]}", "error": "scope", "note": "no alias: absent or null = each"},
    {"name": "rate_fraction", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "rate", "rate": {"const": 0.5}}]}]}]}, "error": "rate", "note": "(0, 1) fails"},
    {"name": "rate_range_through_fraction", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "rate", "rate": {"range": [0, 100]}}]}]}]}, "error": "rate", "note": "a draw may fall in (0, 1)"},
    {"name": "rate_zero", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "rate", "rate": {"const": 0}}]}]}]}, "ok": true, "note": "0 = no limit"},
    {"name": "rate_mixture_zero_or_high", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "rate", "rate": {"dist": {"kind": "mixture", "of": [{"const": 0}, {"range": [1000, 2000]}], "weights": [1, 1]}}}]}]}]}, "ok": true, "note": "each component is 0 or >= 1"},
    {"name": "rate_above_cap", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "rate", "rate": {"const": 18014398509481984}}]}]}]}, "error": "rate", "note": "> 2^53"},
    {"name": "max_len_half", "json": {"version": 1, "machines": [{"states": [{"record": {"max_len": {"const": 64.5}}}]}]}, "plans": [{"max_len": 65}, {"max_len": 65}], "note": "64.5 rounds half away from zero to 65"},
    {"name": "pad_half_down", "json": {"version": 1, "machines": [{"states": [{"record": {"pad": {"const": 2.4}}}]}]}, "plans": [{"pad": 2}, {"pad": 2}], "note": "2.4 rounds to 2"},
    {"name": "max_len_above_cap", "json": {"version": 1, "machines": [{"states": [{"record": {"max_len": {"const": 2147483648}}}]}]}, "error": "max", "note": "length > 2^31-1"},
    {"name": "delay_above_cap", "json": {"version": 1, "machines": [{"states": [{"record": {"delay": {"const": 2000000000.0}}}]}]}, "error": "max", "note": "seconds > 1e9"},
    {"name": "pareto_count_lower", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "set", "value": {"dist": {"kind": "pareto", "params": [2, 1.5]}}}]}]}]}, "ok": true, "note": "pareto lower bound = scale (2) >= 0"},
    {"name": "pareto_inject_cycle", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "inject", "after": {"dist": {"kind": "pareto", "params": [0.01, 2]}}, "len": {"const": 1}}], "next": [{"on": "injected", "to": 0}]}]}]}, "ok": true, "note": "lower bound 0.01 > 0: not a zero-delay cycle"},
    {"name": "geometric_nonneg", "json": {"version": 1, "machines": [{"states": [{"record": {"pad": {"dist": {"kind": "geometric", "params": [0.5]}}}}]}]}, "ok": true, "note": "geometric lower bound = 1 without a min"},
    {"name": "geometric_inject_cycle", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "inject", "after": {"dist": {"kind": "geometric", "params": [0.5]}}, "len": {"const": 1}}], "next": [{"on": "injected", "to": 0}]}]}]}, "ok": true, "note": "geometric lower bound 1 > 0"},
    {"name": "exponential_inject_cycle", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "inject", "after": {"dist": {"kind": "exponential", "params": [10]}}, "len": {"const": 1}}], "next": [{"on": "injected", "to": 0}]}]}]}, "error": "zero delay", "note": "exponential lower bound 0"},
    {"name": "min_max_clamped_lower", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "inject", "after": {"range": [1, 2], "max": 0}, "len": {"const": 1}}], "next": [{"on": "injected", "to": 0}]}]}]}, "error": "zero delay", "note": "max lowers the lower bound to 0"},
    {"name": "min_lifts_normal", "json": {"version": 1, "machines": [{"states": [{"record": {"pad": {"dist": {"kind": "normal", "params": [100, 30]}, "min": 0}}}]}]}, "ok": true, "note": "min 0 lifts normal's lower bound"},
    {"name": "mixture_zero_weight_negative_component", "json": {"version": 1, "machines": [{"states": [{"record": {"pad": {"dist": {"kind": "mixture", "of": [{"const": 5}, {"dist": {"kind": "normal", "params": [0, 1]}}], "weights": [1, 0]}}}}]}]}, "error": "negative", "note": "a component of weight 0 counts"},
    {"name": "mixture_zero_weight_zero_delay", "json": {"version": 1, "machines": [{"states": [{"enter": [{"op": "inject", "after": {"dist": {"kind": "mixture", "of": [{"const": 1}, {"const": 0}], "weights": [1, 0]}}, "len": {"const": 1}}], "next": [{"on": "injected", "to": 0}]}]}]}, "error": "zero delay", "note": "zero-delay check uses the same lower bound (weight-0 components count)"},
    {"name": "empirical_zero_weight_negative_point", "json": {"version": 1, "machines": [{"states": [{"record": {"pad": {"dist": {"kind": "empirical", "points": [5, -1], "weights": [1, 0]}}}}]}]}, "error": "negative", "note": "a point of weight 0 counts"}
  ]
}
