{
  "schema": "carrier-cache-v2",
  "tolerance": {"relative": 0, "absolute": 1e-10},
  "clock_start": "2027-01-15T08:00:00Z",
  "default_key": ["key", "streaming", "variant"],
  "cases": [
    {
      "name": "defaults-half-life",
      "steps": [
        {"op": "score", "expect": {"score": 0.125, "attempts": 0, "weight": 0.0, "cooling": false}},
        {"op": "report", "outcome": "usable"},
        {"op": "score", "expect": {"score": 0.16666666666666666, "attempts": 1, "weight": 1.0, "age_ns": 0}},
        {"op": "advance", "ns": 21600000000000},
        {"op": "score", "expect": {"score": 0.15, "attempts": 1, "weight": 0.5, "age_ns": 21600000000000}},
        {"op": "score", "key": ["key", "streaming", ""], "expect": {"score": 0.125, "attempts": 0}}
      ]
    },
    {
      "name": "performance-expiry",
      "steps": [
        {"op": "report", "outcome": "performance", "rtt_ns": 25000000, "rate_bytes_per_second": 2500000},
        {"op": "score", "expect": {"score": 0.25, "attempts": 0}},
        {"op": "advance", "ns": 59000000000},
        {"op": "report", "outcome": "performance", "at": "2027-01-15T08:00:00Z", "rtt_ns": 1000000},
        {"op": "score", "expect": {"score": 0.25}},
        {"op": "advance", "ns": 1000000000},
        {"op": "score", "expect": {"score": 0.125}}
      ]
    },
    {
      "name": "snapshot-import-errors-are-atomic",
      "steps": [
        {"op": "report", "outcome": "usable"},
        {"op": "save", "as": "before"},
        {"op": "import", "json": "{\"version\":1}", "error": "unsupported-version"},
        {"op": "assert-export", "same_as": "before"},
        {"op": "import", "json": "{\"version\":2", "error": "malformed-snapshot"},
        {"op": "assert-export", "same_as": "before"},
        {"op": "import", "json": "{\"version\":2}", "error": "invalid-value"},
        {"op": "assert-export", "same_as": "before"},
        {
          "op": "import",
          "json": "{\"version\":2,\"exported_at\":\"2027-01-15T09:00:00Z\",\"entries\":[{\"key\":\"z\",\"kind\":\"streaming\",\"variant\":\"\",\"history\":{\"at\":\"2027-01-15T08:59:00Z\",\"age_ns\":60000000000,\"attempts\":1,\"success\":1}},{\"key\":\"key\",\"kind\":\"streaming\",\"cooling\":{\"remaining_ms\":-1}}]}",
          "error": "invalid-value"
        },
        {"op": "assert-export", "same_as": "before"}
      ]
    },
    {
      "name": "cooldown-replay",
      "backoff": {"min_ms": 30000, "max_ms": 1800000, "jitter_down": 0.0, "jitter_up": 0.0},
      "steps": [
        {"op": "report", "outcome": "failed"},
        {"op": "score", "expect": {"attempts": 1, "cooling": true, "remaining_ms": 30000}},
        {"op": "save", "as": "failed"},
        {"op": "advance", "ns": 1000000000},
        {"op": "restart"},
        {"op": "import", "from": "failed"},
        {"op": "score", "expect": {"attempts": 1, "cooling": true, "remaining_ms": 29000}},
        {"op": "advance", "ns": 1000000000},
        {"op": "import", "from": "failed"},
        {"op": "score", "expect": {"attempts": 1, "cooling": true, "remaining_ms": 28000}},
        {"op": "advance", "ns": 28000000000},
        {"op": "score", "expect": {"cooling": false, "remaining_ms": 0}}
      ]
    },
    {
      "name": "export-order-and-newer-anchors",
      "steps": [
        {"op": "report", "key": ["é", "quic", "v"], "outcome": "usable"},
        {"op": "report", "key": ["a", "streaming", "z"], "outcome": "usable"},
        {"op": "report", "key": ["a", "streaming", "a"], "outcome": "usable"},
        {"op": "report", "key": ["a", "quic", ""], "outcome": "usable"},
        {
          "op": "assert-export",
          "key_order": [["a", "quic", ""], ["a", "streaming", "a"], ["a", "streaming", "z"], ["é", "quic", "v"]]
        },
        {"op": "save", "as": "older"},
        {"op": "advance", "ns": 1000000000},
        {"op": "report", "key": ["a", "quic", ""], "outcome": "usable"},
        {"op": "save", "as": "newer"},
        {"op": "import", "from": "older"},
        {"op": "score", "key": ["a", "quic", ""], "expect": {"attempts": 2, "age_ns": 0}},
        {"op": "restart"},
        {"op": "import", "from": "older"},
        {"op": "import", "from": "newer"},
        {"op": "score", "key": ["a", "quic", ""], "expect": {"attempts": 2, "age_ns": 0}}
      ]
    },
    {
      "name": "cooldown-upper-bound",
      "backoff": {"min_ms": 30000, "max_ms": 1800000, "jitter_down": 0.2, "jitter_up": 0.2},
      "steps": [
        {
          "op": "import",
          "json": "{\"version\":2,\"exported_at\":\"2027-01-15T08:00:00Z\",\"entries\":[{\"key\":\"key\",\"kind\":\"streaming\",\"variant\":\"variant\",\"cooling\":{\"at\":\"2027-01-15T08:00:00Z\",\"age_ns\":0,\"nominal_ms\":1800000,\"remaining_ms\":2160000}}]}"
        },
        {"op": "score", "expect": {"cooling": true, "remaining_ms": 2160000}},
        {"op": "save", "as": "bound"},
        {
          "op": "import",
          "json": "{\"version\":2,\"exported_at\":\"2027-01-15T08:00:00Z\",\"entries\":[{\"key\":\"key\",\"kind\":\"streaming\",\"variant\":\"variant\",\"cooling\":{\"at\":\"2027-01-15T08:00:00Z\",\"age_ns\":0,\"nominal_ms\":1800000,\"remaining_ms\":2160001}}]}",
          "error": "invalid-value"
        },
        {"op": "assert-export", "same_as": "bound"}
      ]
    }
  ],
  "snapshots": [
    {
      "name": "rtt-age-survives-wall-clock-rollback",
      "exporter": [
        {"op": "report", "outcome": "performance", "rtt_ns": 1000000},
        {"op": "advance", "ns": 39000000000}
      ],
      "import_at": "2027-01-15T07:00:00Z",
      "importer": [
        {"op": "advance", "ns": 20000000000},
        {"op": "score", "as": "fresh"},
        {"op": "advance", "ns": 1000000000},
        {"op": "score", "as": "expired"}
      ],
      "expected": {
        "fresh": {"score": 0.1767766952966369, "attempts": 0, "weight": 0.0, "age_ns": 0, "cooling": false, "remaining_ms": 0},
        "expired": {"score": 0.125, "attempts": 0, "weight": 0.0, "age_ns": 0, "cooling": false, "remaining_ms": 0}
      }
    }
  ]
}
